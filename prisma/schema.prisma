generator client {
  provider = "prisma-client-js"
  // "native" cobre a maquina de desenvolvimento; o segundo alvo e o
  // sistema usado pelos servidores da Vercel, senao o cliente gerado
  // no build nao roda em producao.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // url: conexao usada pela aplicacao. Em producao (Vercel/Neon) deve ser
  // a conexao AGRUPADA (pooled), porque cada requisicao serverless abre
  // sua propria conexao e o banco esgotaria o limite sem o agrupador.
  url = env("DATABASE_URL")
  // directUrl: conexao DIRETA, usada so pelas migracoes - elas precisam de
  // uma sessao estavel, que o agrupador nao garante. Em desenvolvimento as
  // duas apontam para o mesmo Postgres local.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identidade e governança (DATA_MODEL.md secao "Identidade e governanca")
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String?    @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdBy    String?    @map("created_by")
  archivedAt   DateTime?  @map("archived_at")

  roles       UserRole[]
  auditEvents AuditEvent[] @relation("AuditActor")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Stub de Operacoes (Trip / Operation)
//
// Escopo desta fase: apenas o suficiente para compilar e migrar. O modelo
// completo de Trip (Product, Booking, ChecklistItem, TripResource,
// FinancialEntry etc, conforme DATA_MODEL.md) fica para os tickets de
// modulo de operacoes/financeiro.
//
// Decisao de produto (confirmada com o usuario): Operation NAO substitui
// Trip. Trip e a jornada comercial/produto; Operation e o registro do
// processo operacional de execucao dessa Trip (prontidao, checklist,
// alocacao de recursos, fechamento - modelado em detalhe futuramente).
// Cardinalidade escolhida para o MVP: 1:1 (uma trip tem uma operacao).
// ---------------------------------------------------------------------------

model Trip {
  id         String     @id @default(uuid())
  code       String     @unique
  name       String
  startAt    DateTime   @map("start_at")
  endAt      DateTime   @map("end_at")
  status     TripStatus @default(DRAFT)
  capacity   Int
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  createdBy  String?    @map("created_by")
  archivedAt DateTime?  @map("archived_at")

  operation Operation?

  @@map("trips")
}

enum TripStatus {
  DRAFT
  PLANNING
  ON_SALE
  CONFIRMED
  READY
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

model Operation {
  id             String          @id @default(uuid())
  tripId         String          @unique @map("trip_id")
  status         OperationStatus @default(NOT_STARTED)
  readinessScore Int?            @map("readiness_score")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  createdBy      String?         @map("created_by")
  archivedAt     DateTime?       @map("archived_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("operations")
}

enum OperationStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  CLOSED
}

// ---------------------------------------------------------------------------
// CRM e clientes (DATA_MODEL.md secao "CRM e clientes") - primeiro corte
//
// Escopo desta fase: apenas Customer como cadastro base. Passenger, Lead,
// Pipeline, Opportunity, Activity ficam para o modulo de CRM completo
// (docs/features/crm-sales.md).
// ---------------------------------------------------------------------------

model Customer {
  id         String         @id @default(uuid())
  name       String
  document   String?
  email      String?
  phone      String?
  status     CustomerStatus @default(ACTIVE)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  createdBy  String?        @map("created_by")
  archivedAt DateTime?      @map("archived_at")

  reservations Reservation[]

  @@map("customers")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Fornecedores e recursos (DATA_MODEL.md secao "Fornecedores e recursos")
// - primeiro corte
//
// Decisao de produto: usamos um status simples ACTIVE/INACTIVE para o MVP.
// O workflow completo de homologacao (PROSPECT -> UNDER_REVIEW -> APPROVED
// -> SUSPENDED/REJECTED, ja documentado em DATA_MODEL.md secao 4) fica
// para quando o modulo de homologacao de fornecedores for implementado.
//
// Item (recurso ofertado por um fornecedor, ex: "Onibus 46 lugares",
// "Hotel X", "Seguro viagem X") e terreno novo: nao existe precedente em
// DATA_MODEL.md. Modelado aqui como pertencendo a exatamente um Supplier,
// com uma categoria (tipo de servico) e capacidade opcional (relevante
// para veiculos). Sem preco - preco fica na Reserva, nao no catalogo.
// ---------------------------------------------------------------------------

model Supplier {
  id           String         @id @default(uuid())
  legalName    String         @map("legal_name")
  document     String?
  category     String?
  contactEmail String?        @map("contact_email")
  contactPhone String?        @map("contact_phone")
  status       SupplierStatus @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  createdBy    String?        @map("created_by")
  archivedAt   DateTime?      @map("archived_at")

  items Item[]

  @@map("suppliers")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Item {
  id          String       @id @default(uuid())
  supplierId  String       @map("supplier_id")
  name        String
  category    ItemCategory @default(OTHER)
  capacity    Int?
  description String?
  status      ItemStatus   @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  createdBy   String?      @map("created_by")
  archivedAt  DateTime?    @map("archived_at")

  supplier     Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@index([supplierId])
  @@map("items")
}

enum ItemCategory {
  VEHICLE
  HOTEL
  INSURANCE
  OTHER
}

enum ItemStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Reserva (Reservation) - terreno novo, primeiro corte
//
// Decisao de produto (confirmada com o usuario): esta reserva e
// intencionalmente independente de Trip/Operation - NAO e o Booking de
// DATA_MODEL.md (que exige Trip) nem TripResource (que exige Trip +
// Resource). E um registro standalone de Customer + Item + janela de
// horario + dados comerciais (destino, valores, passageiros), preenchivel
// sem nenhuma Trip/Operation pre-existente.
//
// voucherNumber: numero sequencial permanente (Postgres autoincrement),
// nunca reaproveitado nem reiniciado - usado como referencia unica da
// venda/voucher nos relatorios e conferencias. Reservas nunca sao
// apagadas de verdade, apenas arquivadas via archivedAt.
//
// FKs para Customer e Item usam onDelete: Restrict: nunca queremos que
// apagar um Customer ou Item apague silenciosamente reservas associadas.
//
// Valores em centavos + moeda (ADR-003). marginCents e calculado e
// armazenado no momento da criacao (saleAmountCents - purchaseAmountCents).
// ---------------------------------------------------------------------------

model Reservation {
  id                  String            @id @default(uuid())
  voucherNumber       Int               @unique @default(autoincrement()) @map("voucher_number")
  // Codigo secreto do link publico de autopreenchimento de passageiros
  // (/p/<token>). Aleatorio e nao adivinhavel; quem tem o link consegue
  // adicionar passageiros sem login. Nao expira - para invalidar, gerar
  // um novo token.
  publicToken         String            @unique @default(uuid()) @map("public_token")
  customerId          String            @map("customer_id")
  itemId              String            @map("item_id")
  departureAt         DateTime          @map("departure_at")
  returnAt            DateTime          @map("return_at")
  destinationCity     String            @map("destination_city")
  destinationState    String            @map("destination_state")
  tourStops           String?           @map("tour_stops")
  purchaseAmountCents Int               @map("purchase_amount_cents")
  saleAmountCents     Int               @map("sale_amount_cents")
  marginCents         Int               @map("margin_cents")
  currency            String            @default("BRL")
  responsibleName     String            @map("responsible_name")
  responsiblePhone    String?           @map("responsible_phone")
  customerNotes       String?           @map("customer_notes")
  supplierNotes       String?           @map("supplier_notes")
  status              ReservationStatus @default(PENDING)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  createdBy           String?           @map("created_by")
  archivedAt          DateTime?         @map("archived_at")

  customer   Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  item       Item                   @relation(fields: [itemId], references: [id], onDelete: Restrict)
  passengers ReservationPassenger[]

  @@index([customerId])
  @@index([itemId])
  @@index([departureAt])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Dados sensiveis (CPF/RG/data de nascimento) - BR-CUS-003: visiveis
// somente a papeis com necessidade operacional. Preenchimento pelo
// proprio cliente via link (autoatendimento) e trabalho futuro, ainda
// nao implementado - por enquanto a equipe interna preenche.
model ReservationPassenger {
  id            String    @id @default(uuid())
  reservationId String    @map("reservation_id")
  fullName      String    @map("full_name")
  cpf           String?
  rg            String?
  birthDate     DateTime? @map("birth_date")
  phone         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_passengers")
}
