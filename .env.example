# Aplicação
NODE_ENV=development
LOG_LEVEL=info

# Banco de dados (Docker local: docker compose up -d db)
DATABASE_URL="postgresql://toptur:toptur@localhost:5432/toptur_operations?schema=public"

# Auth.js
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Seed opcional dos usuários iniciais (Lívia e Rogério).
# Se ausentes, o seed cria apenas papéis e permissões, sem usuários.
SEED_LIVIA_EMAIL=""
SEED_LIVIA_PASSWORD=""
SEED_ROGERIO_EMAIL=""
SEED_ROGERIO_PASSWORD=""
