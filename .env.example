# Aplicação
NODE_ENV=development
LOG_LEVEL=info

# Banco de dados (Docker local: docker compose up -d db)
# Use 127.0.0.1 (nao "localhost") - em alguns ambientes Windows/Node, "localhost"
# resolve para IPv6 (::1) e o Docker Desktop so expoe a porta em IPv4.
#
# Em desenvolvimento as duas apontam para o mesmo banco local.
# Em producao (ex: Neon), DATABASE_URL e a conexao AGRUPADA (o host tem
# "-pooler") e DIRECT_DATABASE_URL e a conexao DIRETA, usada so pelas
# migracoes.
DATABASE_URL="postgresql://toptur:toptur@127.0.0.1:5432/toptur_operations?schema=public"
DIRECT_DATABASE_URL="postgresql://toptur:toptur@127.0.0.1:5432/toptur_operations?schema=public"

# Auth.js
# Gerar com: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Endereço que recebe cópia oculta (CCO) dos e-mails de reserva.
TOPTUR_COPY_EMAIL=""

# Seed opcional dos usuários iniciais (Lívia e Rogério).
# Se ausentes, o seed cria apenas papéis e permissões, sem usuários.
SEED_LIVIA_EMAIL=""
SEED_LIVIA_PASSWORD=""
SEED_ROGERIO_EMAIL=""
SEED_ROGERIO_PASSWORD=""
